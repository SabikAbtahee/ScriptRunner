{
  "name": "scriptrunner_2.0",
  "productName": "Script Runner",
  "description": "My Electron application description",
  "keywords": [],
  "main": "./main.js",
  "version": "3.0.0",
  "author": "sabik",
  "scripts": {
    "start": "electron-forge start",
    "dev": "NODE_ENV=development electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make-mac-intel": "electron-forge make --platform=darwin --arch=x64",
    "make-mac-arm": "electron-forge make --platform=darwin --arch=arm64",
    "make-windows": "electron-forge make --platform=win32 --arch=x64",
    "make-linux": "electron-forge make --platform=linux --arch=x64",
    "make-all": "npm run make-mac-intel && npm run make-mac-arm && npm run make-windows && npm run make-linux",
    "tailwind": "npx tailwindcss -i ./styles.css -o ./output.css --watch",
    "build-mac": "electron-builder --mac",
    "lint": "echo 'Add linting here'",
    "test": "echo 'Add tests here'"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "electron": "33.3.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@angular/cli": "18.2.20",
    "cpx": "1.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "node-pty": "^1.0.0",
    "tree-kill": "^1.2.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
